# 设备地址配置 —— 复制成 tools/device.env 后填真实值
#
#   cp tools/device.env.example tools/device.env
#
# tools/device.env 已在 .gitignore 里,**不会被提交**。
# 这样文档和脚本里就不需要出现你的内网地址。
#
# 下面示例用的是 RFC 5737 文档保留地址段(192.0.2.0/24),不是真实地址。

# Android TV(serial 形式,可带端口)
TV_ADDR=192.0.2.11:5555

# Pico 4 / 其他第二台设备
PICO_ADDR=192.0.2.29:5555

# ---- 可选覆盖项 ----

# Android SDK 位置(默认 /opt/android-sdk)
# ANDROID_SDK_DIR=/opt/android-sdk

# Windows 版 adb 路径(默认 tools/platform-tools/adb.exe)
# WINADB=/path/to/adb.exe

# Windows 侧 adb server 端口。不能是 5037 —— WSL mirrored 网络下会和 Linux 侧抢。
# WINADB_PORT=15037
